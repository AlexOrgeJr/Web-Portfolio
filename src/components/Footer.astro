---
import { MoveUp, MoveUpRight } from '@lucide/astro';
import resume from "../assets/ORGE - Resume.pdf";
---

<footer id="contact">
  <div class="top">
    <div class="subtexts">
      <h2>CONTACT</h2>
      <h2>AVAILABLE - 2026</h2>
    </div>

    <h1 class="quote">
      Let's make<br />
      <span>something.</span>
    </h1>
  </div>

  <div class="bottom">
    <div class="b_top">
      <div class="left">
        <h2 class="subtext">START A CONVERSATION</h2>
        <h2 class="email">alexanderorgejr1@gmail.com</h2>
        <button id="copy-email">COPY EMAIL</button>

        <div class="copy-toast" id="copy-toast" role="status" aria-live="polite">
          Email copied successfully
        </div>
      </div>

      <div class="right">
        <h2 class="subtext">ELSEWHERE</h2>
        <a href="https://github.com/AlexOrgeJr" target="_blank" rel="noopener noreferrer">GitHub<MoveUpRight size={15} /></a>
        <a href="https://www.linkedin.com/in/alexorgejr" target="_blank" rel="noopener noreferrer">LinkedIn<MoveUpRight size={15} /></a>
        <a href="https://www.instagram.com/oberon_065/" target="_blank" rel="noopener noreferrer">Instagram<MoveUpRight size={15} /></a>
        <a href={resume} target="_blank" rel="noopener noreferrer">Résumé<MoveUpRight size={15} /></a>
      </div>
    </div>

    <div class="b_bottom">
      <h2 class="subtext">© 2026 AlexOrgeJr.Studio</h2>
      <h2 class="subtext">DESIGNED & BUILT IN PHILIPPINES</h2>
      <h2 class="subtext">BACK TO TOP <MoveUp size={15} /></h2>
    </div>
  </div>
</footer>

<style>
  footer {
    width: 100%;
    height: auto;
    padding: clamp(2rem, 5vw, 4rem) clamp(1.25rem, 6vw, 6rem);
    display: flex;
    flex-direction: column;
    background-color: var(--color-foreground);
    color: var(--color-paper);
  }

  .top {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: clamp(1.5rem, 4vw, 3rem);
    padding-bottom: 7%;
    border-bottom: 1px solid var(--color-muted);
  }

  .top .subtexts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    justify-content: space-between;
  }

  .top .subtexts h2 {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 400;
    color: var(--color-muted);
  }

  .top .quote {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 5vw + 1rem, 9.5rem);
    font-weight: 500;
    line-height: 1.1;
    overflow-wrap: break-word;
  }

  .top .quote span {
    font-style: italic;
  }

  .bottom {
    display: flex;
    flex-direction: column;
    padding-top: 3%;
  }

  .bottom .b_top {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(2rem, 5vw, 3rem);
    padding-bottom: 7%;
  }

  .bottom .b_top .left {
    display: flex;
    flex-direction: column;
    flex: 1 1 320px;
    gap: 1rem;
  }

  .bottom .b_top .right {
    display: flex;
    flex-direction: column;
    flex: 1 1 220px;
  }

  .bottom .b_top .subtext {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 400;
    color: var(--color-muted);
  }

  .bottom .b_top .email {
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 1.5vw + 0.8rem, 2.4rem);
    font-weight: 500;
    overflow-wrap: break-word;
  }

  .bottom .b_top button {
    width: 110px;
    height: 35px;
    margin-top: 15px;
    background-color: var(--color-foreground);
    color: var(--color-muted);
    border: 1px solid var(--color-muted);
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 400;
    cursor: pointer;
  }

  .bottom .b_top button:hover {
    background-color: var(--color-paper);
    color: var(--color-foreground);
  }

  .copy-toast {
    position: fixed;
    bottom: 2rem;
    left: 50%;
    transform: translate(-50%, 20px);

    padding: 12px 18px;
    background: var(--color-foreground);
    color: var(--color-background);

    font-family: var(--font-mono);
    font-size: 0.75rem;

    border-radius: var(--radius-pill);

    opacity: 0;
    visibility: hidden;
    pointer-events: none;

    transition:
      opacity 0.3s ease,
      transform 0.3s ease,
      visibility 0.3s ease;

    z-index: 9999;
  }

.copy-toast.show {
  opacity: 1;
  visibility: visible;
  transform: translate(-50%, 0);
}

  .bottom .b_top .right a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-paper);
    text-decoration: none;
    border-bottom: 1px solid var(--color-muted);
    padding: 15px 0;
  }

  .bottom .b_bottom {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    justify-content: space-between;
  }

  .bottom .b_bottom h2 {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 400;
    color: var(--color-muted);
  }

  .bottom .b_bottom h2:last-child {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
  }
</style>

<script>
  const copyButton = document.querySelector("#copy-email");
  const copyToast = document.querySelector("#copy-toast");
  const email = "alexanderorgejr1@gmail.com";

  copyButton?.addEventListener("click", async () => {
    try {
      await navigator.clipboard.writeText(email);

      // Change button text
      copyButton.textContent = "COPIED!";

      // Show confirmation
      copyToast?.classList.add("show");

      // Reset after 2 seconds
      setTimeout(() => {
        copyButton.textContent = "COPY EMAIL";
        copyToast?.classList.remove("show");
      }, 2000);

    } catch (error) {
      console.error("Failed to copy email:", error);
    }
  });
</script>