<div id="live-clock" class="live-clock">
  <span id="clock-time">--:--:--</span>
  <span id="clock-tz"></span>
</div>

<script>
  const timeEl = document.getElementById('clock-time')!;
  const tzEl = document.getElementById('clock-tz')!;

  const timeZone = Intl.DateTimeFormat().resolvedOptions().timeZone;
  tzEl.textContent = timeZone;

  const formatter = new Intl.DateTimeFormat('en-US', {
    timeZone,
    hour: '2-digit',
    minute: '2-digit',
    second: '2-digit',
    hour12: true,
  });

  function updateClock() {
    // Replace any narrow no-break space (U+202F) or regular space
    // before AM/PM with a guaranteed non-breaking space, so "PM"
    // can never wrap onto its own line.
    const formatted = formatter.format(new Date()).replace(/[\s\u202f]+(AM|PM)/, '\u00A0$1');
    timeEl.textContent = formatted;
  }

  updateClock();
  setInterval(updateClock, 1000);
</script>

<style>
  .live-clock {
    width: 100%;
    height: 100%;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 400;
    color: var(--color-muted);
    display: flex;
    flex-wrap: nowrap;
    gap: 0.5rem;
    align-items: baseline;
  }

  #clock-time {
    flex-shrink: 0;
    white-space: nowrap;
  }

  #clock-tz {
    font-size: 0.85rem;
    flex-shrink: 0;
    white-space: nowrap;
  }
</style>